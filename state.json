  "rbn_queue": [
    {
      "n": 4,
      "t": "وفي حدود المملكة للحرب دگينا الطبول",
      "ts": 1795557930
    },
    {
      "n": 0,
      "t": "السعودية تهدد مجدداً باستهداف ميناء الحديدة اليمني، وتأمر بإخلائه..",
      "ts": 1795557935
    },
    {
      "n": 0,
      "t": "الناشط الكردي المستقل كاروخ عمر:\n\nعائلة بارزاني تمثل بلاءً كبيراً على الشعب الكردي بأكمله، ولن يموت مسعود بارزاني حتى يقضي على الشعب الكردي بأسره.",
      "ts": 1795558254
    },
    {
      "n": 0,
      "t": "عدوان سعودي غاشم يستهدف ميناء الحديدة اليمني",
      "ts": 1795558534
    },
    {
      "n": 0,
      "t": "العميد يحيى سريع: تعلن القوات المسلحة أن ميناء جدة وجميع الموانئ السعودية المعادية على طول ساحل البحر الأحمر ستكون أهدافاً لقواتنا إذا نفذ العدو تهديداته بقصف ميناء الحديدة\n\n‏نحذر الموظفين والعمال وأي شخص بالقرب من هذه الموانئ بضرورة إخلائها فوراً والابتعاد عنها، وندعو جميع شركات الشحن إلى إخراج سفنها من تلك الموانئ على الفور.",
      "ts": 1795558537
    },
    {
      "n": 0,
      "t": "المتحدث باسم القوات المسلحة اليمنية، العميد يحيى سريع:\n\n\"تعلن القوات المسلحة أن ميناء جدة وجميع الموانئ السعودية المعادية على طول ساحل البحر الأحمر ستكون أهدافاً لقواتنا إذا نفذ العدو تهديداته بقصف ميناء الحديدة\".\n\n‏نحذر الموظفين والعمال وأي شخص بالقرب من هذه الموانئ بضرورة إخلائها فوراً والابتعاد عنها، وندعو جميع شركات الشحن إلى إخراج سفنها من تلك الموانئ على الفور.",
      "ts": 1795558541
    },
    {
      "n": 0,
      "t": "استنفار و تحركات لميليشيات البيشمركة في محافظة دهوك شمال العراق",
      "ts": 1795558544
    },
    {
      "n": 0,
      "t": "ميناء الملك فهد الصناعي و ميناء ينبع وميناء جدة وايضاً ميناء جيزان سيصبحوا تحت مرمى الصواريخ والطائرات المسيرة اليمنية بحال العدو السعودي شن عدوانه على ميناء الحديدة",
      "ts": 1795558835
    },
    {
      "n": 0,
      "t": "وزارة الخارجية الأمريكية: يجب على الأمريكيين في منطقة الشرق الأوسط توخي أقصى درجات الحذر بسبب تزايد خطر الهجمات المسلحة من قبل الحوثيين المدعومين من إيران، وجهود إيران لاستهداف المسؤولين الأمريكيين والمرافق الحكومية في المنطقة.",
      "ts": 1795559134
    },
    {
      "n": 0,
      "t": "وزارة الخارجية الأمريكية:\nينبغي على الأمريكيين المقيمين في الشرق الأوسط توخي الحذر الشديد نظراً لتزايد خطر الهجمات المسلحة التي يشنها الحوثيون المدعومون من إيران، وجهود إيران لاستهداف المسؤولين والمنشآت الحكومية الأمريكية في المنطقة. يرجى الانتباه إلى أي تنبيهات محتملة، وإلغاء الرحلات الجوية، وإغلاق المجال الجوي، واضطرابات السفر.\n‏شنت إيران هجمات استهدفت مصالح أمريكية في كل من البحرين والكويت، كما انخرط الحوثيون المدعومون من إيران في أعمال عدائية ضد السعودية، شملت هجمات على مطارات مدنية وبنى تحتية حيوية أخرى، ما أسفر عن سقوط ضحايا مدنيين واضطرابات حادة في حركة النقل. وتواجه هذه الأعمال العدائية احتمال التصعيد السريع.\n‏",
      "ts": 1795559137
    },
    {
      "n": 0,
      "t": "وزارة الخارجية الأميركية:\n\nيجب على الأميركيين في الشرق الأوسط توخي الحذر الشديد بسبب زيادة التهديد بهجمات مسلحة من قبل الحوثيين المدعومين من إيران، وبسبب جهود إيران لاستهداف المسؤولين الأمريكيين والمنشآت الحكومية في المنطقة، مع احتمال إغلاق المجال الجوي وإلغاء الرحلات واضطرابات السفر.",
      "ts": 1795559140
    },
    {
      "n": 0,
      "t": "انفجارات في المنطقة الشرقية بالسعودية جراء هجوم بالطيران المسير اليمني",
      "ts": 1795559726
    },
    {
      "n": 0,
      "t": "دوي انفجارت في المنطقة الشرقية السعودية",
      "ts": 1795559730
    },
    {
      "n": 0,
      "t": "تأكيدا لما انفردنا به\n\nدويلة السعودية تعترف بتعرض المنطقة الشرقية لهجوم بالمسيرات",
      "ts": 1795559734
    },
    {
      "n": 0,
      "t": "توقف حركة الملاحة الجوية في مطار الدمام شرق السعودية بالتزامن مع الهجوم اليمني",
      "ts": 1795560332
    },
    {
      "n": 0,
      "t": "تنويه\n\nلمتابعينا الكرام ندعوكم لمتابعة جميع قنوات نيوز ، الروابط أدناه تضم القنوات الرسمية لمجموعة قنوات نيوز بما فيها القنوات الاحتياطية.\n\nنيوز الأساسية\n\nنيوز الاجتماعية\n\nنيوز الاحتياطية\n\nنيوز بلس\n\nمونتير الطاهرة\n\nنيوز على منصة X\n#مشاركتك_رصاصة",
      "ts": 1795563637
    },
    {
