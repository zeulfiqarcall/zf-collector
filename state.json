  "rbn_queue": [
    {
      "n": 1,
      "t": "ميليشيات البيشمركة تغلق الطرق المؤدية إلى شمال العراق، لمنع الجيش العراقي من التقدم.",
      "ts": 1795602645
    },
    {
      "n": 0,
      "t": "استهداف سفينة في مضيق هرمز قبالة السواحل العمانية",
      "ts": 1795602925
    },
    {
      "n": 0,
      "t": "جواد بيروخي، قائد قيادة القوات الخاصة لميليشيا البيشمركة التابعة للقجقجي مسعود البارزاني:\n\nالجيش العراقي وحكومته ليسا موضع ثقة، وقواتنا على أهبة الاستعداد لأي طارئ.",
      "ts": 1795602930
    },
    {
      "n": 0,
      "t": "المقاومة الاسلامية حركة النجباء تقيم دعوى قضائية ضد النائب عبد الهادي الحسناوي، على خلفية ظهوره في مقطع مصوّر اتهم فيه المقاومة الإسلامية حركة النجباء بالتورط في عمليات تهريب النفط بمحافظة النجف الأشرف.",
      "ts": 1795602934
    },
    {
      "n": 0,
      "t": "طائرة رجال اعمال متجه الى قبرص تطلق نداء طوارئ",
      "ts": 1795603234
    },
    {
      "n": 0,
      "t": "ميليشيات البيشمركة في شمال العراق تدفع بتعزيزات جديدة على خطوط التماس مع الحكومة المركزية",
      "ts": 1795603238
    },
    {
      "n": 0,
      "t": "جانب اخر من ارسال تعزيزات عسكرية لمليشيا البيشمركة إلى خطوط التماس مع الحكومة الاتحادية",
      "ts": 1795603534
    },
    {
      "n": 0,
      "t": "حكومة القجقجي مسعود البرازاني: سنُرفع دعوى قضائية ضد كل من يحرّض الناس ضد كيان الإقليم",
      "ts": 1795603537
    },
    {
      "n": 0,
      "t": "اعتقال فرحان الفرطوسي بتهم فساد في القاهرة",
      "ts": 1795603542
    },
    {
      "n": 0,
      "t": "تعزيزات عسكرية متواصلة لمليشيات البيشمركة على الطريق المؤدي إلى مخمور في نينوى، بالتزامن مع تصاعد التوترات مع الحكومة في بغداد.",
      "ts": 1795603831
    },
    {
      "n": 0,
      "t": "اعتقال مدير الموانئ العراقية السابق فرحان الفرطوسي بتهم فساد في العاصمة المصرية القاهرة",
      "ts": 1795603835
    },
    {
      "n": 0,
      "t": "ميليشيات البيشمركة تواصل دفعها للتعزيزات العسكرية على خطوط التماس في اربيل شمال العراق.",
      "ts": 1795603840
    },
    {
      "n": 0,
      "t": "في ظل التصعيد المستمر بين حكومة القجقجي مسعود البارزاني والحكومة المركزية، شلل تام يصيب أسواق محافظة أربيل.",
      "ts": 1795604129
    },
    {
      "n": 0,
      "t": "رصد تحركات لميليشيات الطالباني في محافظة السليمانية.",
      "ts": 1795604449
    },
    {
      "n": 0,
      "t": "علي حمه صالح زعيم تيار الموقف الوطني المعارض في شمال العراق:\n\nأقسم بالله أن أحد أبناء بارزاني تبلغ ثروته 6 مليارات دولار، ولديهم أبناء مُنحوا أراضيَ تُقدَّر قيمتها بـ 700 مليون دولار.",
      "ts": 1795604454
    },
    {
      "n": 0,
      "t": "ميليشيات بافل الطالباني تنتشر في مدينة كلار",
      "ts": 1795604730
    },
    {
      "n": 0,
