  "rbn_queue": [
    {
      "n": 0,
      "t": "حركة التغيير الكردية (گوران):\n\nقرارات رئيس الوزراء العراقي الصادرة اليوم بشأن إقليم كوردستان تطور خطير\n\nحماية الكيان الدستوري لإقليم كوردستان مسؤولية تاريخية",
      "ts": 1795529130
    },
    {
      "n": 0,
      "t": "منع احمد ملا طلال من الظهور الإعلامي لمدة ثلاثة اشهر.",
      "ts": 1795529434
    },
    {
      "n": 0,
      "t": "فرانس برس:\n\nتعرض برج صندوق الاستثمارات العامة السعودي (PIF) في الرياض لضربة جديدة وهي الثانية خلال أقل من أسبوع، فيما حذرت سيارات مزودة بمكبرات صوت الموجودين في المنطقة وطالبتهم بالاحتماء بسبب الانفجارات.",
      "ts": 1795529745
    },
    {
      "n": 0,
      "t": "رئيس كتلة الاتحاد الإسلامي الكوردستاني: الزيدي لا يملك خلفية سياسية، والقرارات كانت متوقعة.",
      "ts": 1795529748
    },
    {
      "n": 0,
      "t": "رسالة من مسعود بارزاني\n\nمنذ مدة يُلحظ في مراكز القرار العراقي تحرّك وتصعيد غير طبيعي ضد إقليم كوردستان، يتمثّل في محاولة انتهاك مبادئ الفيدرالية ودستور العراق، وتجاهل حقوق شعب كوردستان، وطرح قرارات وأفكار غير سليمة ومجازِفة.",
      "ts": 1795529755
    },
    {
      "n": 0,
      "t": "مسعود بارزاني في رسالة يحذر في رسالة من تصعيد غير طبيعي في بغداد يهدف لانتهاك الفيدرالية وحق شعب كوردستان.\n\nيرفض بارزاني الحملات الإعلامية ضد الإقليم، مؤكداً أن حل الخلافات لا يتم عبر قرارات أحادية.\n\nويؤكد الإقليم على تمسكه بحقوقه المشروعة التي تحققت عبر نضال مئة عام، مرفضاً الخضوع لأي قرارات غير دستورية.",
      "ts": 1795529759
    },
    {
      "n": 0,
      "t": "بحلقي كلمة بدي قولها\n\nبس مش عبتطلع ياسندي",
      "ts": 1795530037
    },
    {
      "n": 0,
      "t": "الإعلام الأمني: ضبط منصتين لإطلاق الطائرات المسيّرة مخبأتين في الأراضي الزراعية بقضاء علي الغربي شمال ميسان.",
      "ts": 1795530329
    },
    {
      "n": 0,
      "t": "التجارب الصاروخية للحرس الثوري مستمرة في عدة مدن إيرانية.",
      "ts": 1795530334
    },
    {
      "n": 0,
      "t": "تأكيداً لما نشرناه سابقاً\n\nفرانس برس: أفاد ثلاثة شهود بتضرر أعلى ناطحة سحاب في العاصمة السعودية الرياض، والتي تضم مقر صندوق الاستثمارات العامة السعودي (KAFD) جراء استهدافها.",
      "ts": 1795530644
    },
    {
      "n": 0,
      "t": "استمرار المناورات الصاروخية التابعة للحرس الثورة الإسلامية في ايران",
      "ts": 1795530646
    },
    {
      "n": 0,
      "t": "وزير الداخلية في الإقليم ريبر أحمد: لن نلتزم بأي بيان أو قرار أو تعليمات أو قانون يخالف الدستور.",
      "ts": 1795530929
    },
    {
      "n": 0,
      "t": "انباء عن منع سيطرة اربيل دخول العراقين العرب الى اربيل، نتيجة التوتر الأخير مع الزيدي .",
      "ts": 1795530932
    },
    {
      "n": 0,
      "t": "بأوامر من القچقچي مسعود بارزاني\n\nتحركات لعناصر مسلحة تابعة لـميليشيا\"حزب الحرية لكردستان\" وهو أحد أحزاب المعارضة الإيرانية الارهابية الذي يقوده حسين يزدان بناه، باتجاه منطقة \"كلك\" (خبات) الواقعة غرب مدينة أربيل",
      "ts": 1795532453
    },
    {
      "n": 0,
      "t": "وزير الداخلية في الإقليم ريبر أحمد: يعتقد بعض الذين يفكرون بهذه الطريقة في بغداد أن كل شيء يجب أن يكون تحت سيطرة بغداد، كما كان الحال قبل عام 2003.",
      "ts": 1795532730
    }
  ],
