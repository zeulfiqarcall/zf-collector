  "rbn_queue": [
    {
      "n": 0,
      "t": "التجارب الصاروخية للحرس الثوري مستمرة في عدة مدن إيرانية.",
      "ts": 1795530334
    },
    {
      "n": 0,
      "t": "تأكيداً لما نشرناه سابقاً\n\nفرانس برس: أفاد ثلاثة شهود بتضرر أعلى ناطحة سحاب في العاصمة السعودية الرياض، والتي تضم مقر صندوق الاستثمارات العامة السعودي (KAFD) جراء استهدافها.",
      "ts": 1795530644
    },
    {
      "n": 0,
      "t": "استمرار المناورات الصاروخية التابعة للحرس الثورة الإسلامية في ايران",
      "ts": 1795530646
    },
    {
      "n": 0,
      "t": "وزير الداخلية في الإقليم ريبر أحمد: لن نلتزم بأي بيان أو قرار أو تعليمات أو قانون يخالف الدستور.",
      "ts": 1795530929
    },
    {
      "n": 0,
      "t": "انباء عن منع سيطرة اربيل دخول العراقين العرب الى اربيل، نتيجة التوتر الأخير مع الزيدي .",
      "ts": 1795530932
    },
    {
      "n": 0,
      "t": "بأوامر من القچقچي مسعود بارزاني\n\nتحركات لعناصر مسلحة تابعة لـميليشيا\"حزب الحرية لكردستان\" وهو أحد أحزاب المعارضة الإيرانية الارهابية الذي يقوده حسين يزدان بناه، باتجاه منطقة \"كلك\" (خبات) الواقعة غرب مدينة أربيل",
      "ts": 1795532453
    },
    {
      "n": 0,
      "t": "وزير الداخلية في الإقليم ريبر أحمد: يعتقد بعض الذين يفكرون بهذه الطريقة في بغداد أن كل شيء يجب أن يكون تحت سيطرة بغداد، كما كان الحال قبل عام 2003.",
      "ts": 1795532730
    },
    {
      "n": 0,
      "t": "الدفاع المدني السعودي: إصابة 11 شخصاً في هجوم اليمني استهدف برجاً في الحي المالي بالرياض.",
      "ts": 1795533036
    },
    {
      "n": 0,
      "t": "وزير الداخلية في إقليم كردستان ريبر أحمد يهدد بغداد ويؤكد انه لن يكون الإقليم تحت سيطرة بغداد، كما كان الحال قبل عام 2003.",
      "ts": 1795533042
    },
    {
      "n": 0,
      "t": "الإعلان عن إصابة 11 شخصاً في هجوم القوات المسلحة اليمنية الذي استهدف برجاً في العاصمة السعودية الرياض.",
      "ts": 1795533340
    },
    {
      "n": 0,
      "t": "إصابة 11 شخصاً في هجوم القوات المسلحة اليمنية الذي استهدف برجاً في الرياضط",
      "ts": 1795533344
    },
    {
      "n": 0,
      "t": "النزاهة: الحبس الشديد لمُدَّة سنتين وغرامة ماليَّة بحقّ مدير مركز شرطة أحداث الرصافة",
      "ts": 1795533638
    },
    {
      "n": 0,
      "t": "اللواء وحيدي: لن نشهد حربًا إقليمية أخرى كما قال قائد الثورة الأعظم، لم تعد الحرب اليوم تقتصر على الصعيد الإقليمي، ويمكننا أن نشهد توسعًا في نطاق المعارك في أي نقطة تتطلب ذلك.",
      "ts": 1795534528
    },
    {
      "n": 0,
      "t": "بتوجيهٍ من القجقجي مسعود البارزاني لجميع سيطرات الإقليم،،،أيُّ شخصٍ لا يحمل نفوس (بطاقة سكن أو أحوال) أربيل، أو دهوك، أو السليمانية، لن يُسمح له بالدخول إلى حدود شمال العراق.",
      "ts": 1795534532
    },
    {
      "n": 0,
      "t": "هيئة إدارة الممر المائي للخليج الفارسي:\n\nإضافة 26 قاطرة بحرية إلى قائمة عدم الامتثال، بعد تقديمها خدمات لسفن مخالفة جنوب مضيق هرمز، وذلك استناداً إلى بلاغات مواطنين من دول الجوار الجنوبي لإيران ومعلومات استخباراتية.\n\nنؤكد أن أي سفن أو شركات تتعاون في تقديم الخدمات للسفن المخالفة ستُدرج بدورها ضمن قائمة عدم الامتثال.",
      "ts": 1795535134
    },
    {
      "n": 0,
      "t": "هيئة إدارة الممر المائي للخليج الفارسي: إضافة 26 قاطرة بحرية إلى قائمة عدم الامتثال\n\n- نظرًا لقيام بعض القاطرات البحرية بتقديم خدمات للسفن المخالفة في جنوب مضيق هرمز، فقد تمت إضافة 26 قاطرة من هذا النوع إلى قائمة عدم الامتثال، وذلك بناءً على بلاغات من مواطني دول الجوار الجنوبي لإيران والرصد الاستخباراتي التابع لهيئة (PGSA).\n- وكما أُعلن سابقًا، فإن السفن والشركات التي تتعاون في تقديم الخدمات للمخالفين ستُدرج هي الأخرى ضمن قائمة عدم الامتثال.",
      "ts": 1795535138
    }
  ],
