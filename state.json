  "rbn_queue": [
    {
      "n": 0,
      "t": "جيش الجمهورية الاسلاميةالايرانية: تدمير طائرتين بدون طيار من طراز \"لوكاس\" و \"MQ-9\" فوق خليج فارس من قبل قوات الدفاع الجوي التابعة للجيش.",
      "ts": 1795549254
    },
    {
      "n": 0,
      "t": "الحكومة النيوزيلندية تجدد تحذيرها لمواطنيها: لا تسافروا إلى السعودية بسبب استمرار الضربات بالصواريخ والطائرات المسيّرة",
      "ts": 1795549257
    },
    {
      "n": 0,
      "t": "الجيش الإيراني يعلن إسقاط مسيرتين من طراز لوكاس و MQ-9 في سماء مضيق هرمز.",
      "ts": 1795549264
    },
    {
      "n": 0,
      "t": "امريكا تنهار من الداخل\n\n‏اختراق سيبراني يطال وكالة الاستخبارات المركزية ومكتب مدير الاستخبارات الوطنية الأميركي.",
      "ts": 1795549834
    },
    {
      "n": 0,
      "t": "استمرار تحشيدات ميليشيا القجقجي مسعود البارزاني في المحاور العسكرية بمحافظة أربيل.",
      "ts": 1795549840
    },
    {
      "n": 0,
      "t": "اعلام العدو الامريكي:‏ اختراق سيبراني يطال وكالة الاستخبارات المركزية ومكتب مدير الاستخبارات الوطنية الأميركي",
      "ts": 1795549844
    },
    {
      "n": 0,
      "t": "قيادي في حزب القجقجي مسعود البارزاني عبدالله كويخا مبارك يتجاوز على الدستور: الرد على السلاح هو السلاح فقط، ولا يوجد قانون آخر حتى القانون والدستور لا يساويان فردة حذاء كردي تقليدي (كلاش) إذا كانا سيسلبان منا الوطن والحقوق والحرية القومية.",
      "ts": 1795550127
    },
    {
      "n": 0,
      "t": "صواريخ يمنية تنطلق باتجاه اهداف معادية",
      "ts": 1795550131
    },
    {
      "n": 0,
      "t": "تحشدات مستمرة لميليشيات البيشمركة التابعة للبارزاني على القطعات العسكرية في اربيل شمال العراق.",
      "ts": 1795550134
    },
    {
      "n": 0,
      "t": "استمرار تحشيدات البيشمركة الممتدة على طول الحدود الادارية لاقليم كوردستان العراق.",
      "ts": 1795550445
    },
    {
      "n": 0,
      "t": "مصدر حكومي لـ\n\nينفي الأنباء المتداولة عن اقالة المهندس مصطفى سند المرياني من منصبه كوزير اتصالات .",
      "ts": 1795550451
    },
    {
      "n": 0,
      "t": "انطلاق تظاهرة بالبحرين تضامناً مع العلماء ورفضاً للأحكام الجائرة بحق العلماء.",
      "ts": 1795550454
    },
    {
      "n": 0,
      "t": "تكليف اللواء حسن كاظم رئيساً لهيئة المنافذ الحدودية",
      "ts": 1795550458
    },
    {
      "n": 0,
      "t": "ريبوار كريم صحفي وكاتب سياسي كردي: هذا بداية نهاية مسرور بارزاني.",
      "ts": 1795550461
    },
    {
      "n": 0,
      "t": "المعارض السياسي اوميد محمد:\n\n- قيمة تهريب النفط تصل لــ 120 مليار دولار 15 منها كمستحقات شركات والمتبقي بيد الحزبين الحاكمين\n- حكومة الاقليم غطاء رسمي للسرقة ونهب الثروات\n- احزاب الاقليم رفضت قرارات بغداد خوفا على مصالحها وثرواتها فقط\n- الشعب الكردي يعاني وبرميل النفط الابيض وصل لاكثر من 350 الف دينار\n- المواطن الكردي مقموع ومظلوم ويعيش حالة لا تطاق\n- المواطن الكردي يرحب باي حراك يخلصه من الزمرة الفاسدة في الاقليم",
      "ts": 1795550466
    },
    {
      "n": 0,
      "t": "متداول... البرزاني في محاولة لتقريب القيادات المجتمعية نحوهه حيث أمر بإطلاق سراح خورشيد هركي وجميع المعتقلين من أبناء عشيرته.",
      "ts": 1795550728
    },
    {
      "n": 0,
      "t": "أنباء شبه مؤكدة تفيد بأنه سيتم الإفراج عن خورشيد الهركي ومن معه من المعارضين، بأمر من القجقجي مسعود البارزاني، وذلك خوفاً من أن تشن عشيرة الهركي حرباً ضده في ظل التصعيد الحالي مع الحكومة المركزية.",
      "ts": 1795551039
    },
    {
      "n": 0,
      "t": "نيويورك تايمز: تعرض وكالتي الاستخبارات المركزية الأمريكية (CIA) ومديرية الاستخبارات الوطنية (ODNI) لاختراق سيبراني، طال بعض المعلومات غير المصنّفة سرّية.",
      "ts": 1795551331
    },
    {
      "n": 0,
      "t": "الولايات المتحدة تواصل نشر مقاتلات F-35B في قاعدة عوفدا الجوية جنوب فلسطين المحتلة.",
      "ts": 1795551335
    }
  ],
