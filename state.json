  "rbn_queue": [
    {
      "n": 0,
      "t": "إعلام العدو الامريكي : ترامب يفكر في مجموعة من الخيارات بشأن إيران.",
      "ts": 1795537844
    },
    {
      "n": 0,
      "t": "سماع دوي انفجار قرب احد القواعد الامريكية في البحرين وبعدها بدقيقة تم اطلاق صاروخ اعتراضي من القاعدة نفسها.",
      "ts": 1795538130
    },
    {
      "n": 0,
      "t": "عضو لجنة الأمن والدفاع في البرلمان العراقي، النائب مازن غريب: يجب على الجميع قوى والاحزاب الكردية التوحد ضد قرارات الحكومة الاتحادية.",
      "ts": 1795538134
    },
    {
      "n": 0,
      "t": "الإعلام الامني: بعض المحافظين في الإقليم يمنحون موافقات لتصدير النفط دون العودة لشركة سومو",
      "ts": 1795538438
    },
    {
      "n": 0,
      "t": "الإعلام الامني: المنافذ الحدودية بوابة سيادية للدولة يجب أن تخضع لأوامر الحكومة الاتحادية",
      "ts": 1795538440
    },
    {
      "n": 0,
      "t": "الله اكبر\n\nالبحرية البريطانية تعلن عن استهداف ناقلة نفط جديدة بمقذوف في مضيق هرمز.",
      "ts": 1795539034
    },
    {
      "n": 0,
      "t": "البحرية البريطانية تُعلن استهداف سفينة جديدة الآن، في مضيق هرمز.",
      "ts": 1795539037
    },
    {
      "n": 0,
      "t": "وزير صهيوني سابق:\n\nإيران تعمل على تطوير سلاح كيماوي لمهاجمة إسرائيل",
      "ts": 1795539338
    },
    {
      "n": 0,
      "t": "هيئة عمليات التجارة البحرية البريطانية: تعرض ناقلة نفط لضربة بمقذوف مجهول أثناء عبورها باتجاه الشرق.",
      "ts": 1795539341
    },
    {
      "n": 0,
      "t": "وزير صهيوني : إيران تعمل على تطوير سلاح كيماوي لمهاجمة إسرائيل.",
      "ts": 1795539345
    },
    {
      "n": 0,
      "t": "وزير اسرائيلي : إيران تعمل على تطوير سلاح كيمياوي لمهاجمة إسرائيل",
      "ts": 1795539653
    },
    {
      "n": 0,
      "t": "وزير الدفاع الصهيوني يسرائيل كاتس:\n\nإيران بصدد تطوير سلاح كيميائي، وفي إسرائيل والولايات المتحدة يعلمون ذلك ولن نسمح لهم ببلوغ هذه القدرات\n\nالقيادة الوسطى الأمريكية والجيش الإسرائيلي جاهزون لإمكانية مهاجمة إيران والقرار بيد ترامب\n\nمن يقول إن لا حاجة ملحة للتدخل في إيران، إما أنه لا يمتلك معلومات أو يقول ذلك لسبب آخر",
      "ts": 1795540237
    },
    {
      "n": 0,
      "t": "احدى عشائر محافظة المثنى تتجمع ردا على اختطاف خمسة افراد من عشيرتهم في محافظة ميسان جنوبي العراق.",
      "ts": 1795540241
    },
    {
      "n": 0,
      "t": "وزير الدفاع الصهيوني؛ كاتس:\n\nالجيش الإسرائيلي والقيادة الوسطى الأميركية يستعدان لشن هجوم على إيران لكنّ القرار بيد ترامب.\n\n‏ إسرائيل وأميركا على علم بتطوير إيران أسلحة كيميائية.",
      "ts": 1795540244
    },
    {
      "n": 0,
      "t": "محافظ بغداد يوجه كتابا رسميا لوضع حد لممارسات القوات الأمنية بابتزاز الاهالي من أطراف بغداد من إدخال مواد البناء إلى أراضيهم.",
      "ts": 1795540247
    },
    {
      "n": 0,
      "t": "النائب محمد جاسم الخفاجي:\n\n- 101 مليار دولار أضرار عدم تسليم كميات النفط المطلوبة وفقا للموازنات منذ 17 سنة\n- 79 مليار دولار تصدير النفط خارج سومو\n- 123 مليار دولار نتيجة السيطرة على حقول نفطية تابعة لشركة نفط الشمال الإتحادية المجموع = 303 مليار دولار خسائر الحكومة الاتحادية جراء عدم التزام الإقليم على مدار سنوات لغاية اليوم بالعراقي = 460 تريليون دينار عراقي وفقا لتقرير ديوان الرقابة المالية الإتحادي",
      "ts": 1795540250
    },
    {
      "n": 0,
      "t": "وزير الخارجية الايراني السيد عباس عراقجي:\n\nالولايات المتحدة قلقة للغاية بشأن الأسلحة الكيميائية لدرجة أنها تُعيق عمل هيئة مراقبة الأسلحة الكيميائية العالمية.\n\nقد تُضطر منظمة حظر الأسلحة الكيميائية إلى تعليق عملها وتقليص برامجها الحيوية. وبعرقلة ولايتها، تُعرّض الولايات المتحدة السلام والأمن العالميين للخطر عمداً. أمرٌ مُخزٍ.",
      "ts": 1795540541
    },
    {
      "n": 0,
      "t": "انفجار اربيل",
      "ts": 1795540544
    },
    {
      "n": 0,
      "t": "اولي : سماع دوي انفجارات في كوية بمحافظة اربيل شمال العراق.",
      "ts": 1795540550
    }
  ],
