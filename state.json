    {
      "n": 2,
      "t": "المجلس الوطني الكوردي السوري: نرفض أي تهديد عسكري يستهدف إقليم كردستان.",
      "ts": 1795613130
    },
    {
      "n": 0,
      "t": "المزيد من صور الأقمار الصناعية تُظهر أضراراً بمبنى الركاب رقم 4 في مطار الملك خالد الدولي بالعاصمة السعودية الرياض.",
      "ts": 1795613445
    },
    {
      "n": 0,
      "t": "ترفيهي\nمايسمى المجلس الوطني الكوردي السوري: نرفض أي تهديد عسكري يستهدف إقليم كردستان.",
      "ts": 1795613449
    },
    {
      "n": 0,
      "t": "العراق // اعفاء رئيس فريق الجهد الخدمي والهندسي المهندس عبد الرزاق المالكي من منصبه",
      "ts": 1795613735
    },
    {
      "n": 0,
      "t": "اندلع حريق هائل في أحد المصانع بمحافظة أربيل",
      "ts": 1795613739
    },
    {
      "n": 0,
      "t": "طائرة استطلاع تابعة للبحرية الأمريكية من طراز P-8 Poseidon فوق شرق المتوسط قبالة دمياط في مصر",
      "ts": 1795614334
    },
    {
      "n": 0,
      "t": "البنك المركزي العراقي: منع المصارف منعاً باتاً من إجراء تحويلات مالية لتمويل الاستيراد من الأردن لغير الجهات أو الشركات المصنعة الحقيقية للمنتج داخل المملكة بشرط استكمال وتدقيق كافة الوثائق والشهادات الأصولية التي تثبت المنشأ الأردني الفعلي للبضاعة قبل تمرير أي عملية تحويل مالي",
      "ts": 1795614634
    },
    {
      "n": 0,
      "t": "تحديث\n\nعمود دخان ضخم يرتفع وسط محافظة أربيل جراء الحريق الذي اندلع في أحد مصانعها.",
      "ts": 1795614640
    },
    {
      "n": 0,
      "t": "الرصد اليومي لطلعات العدو الجوية التي يخرق بها السيادة العراقية:\n\nيستمر العدو في انتهاكه الصارخ لسيادتنا الجوية، انطلاقا من قواعدهم في الأردن.\n\n- طائرات (MQ-9) عدد 11.\n- طائرات (MQ-1) عدد 3.\n- طائرات (U-25 drone) عدد 1.\n- طائرات (BEECH-350) عدد 1.\n\nيوم الثلاثاء 24 - 11 - 2026",
      "ts": 1795614934
    },
    {
      "n": 0,
      "t": "قائممقامية أربيل: توجه الدوائر الحكومية والمدارس والجامعات بعدم منع أي موظف أو طالب من المشاركة في مظاهرات غداً الخميس وذلك للتحشيد أمام قلعة أربيل احتجاجاً على تحركات الحكومة الاتحادية",
      "ts": 1795616435
    },
    {
      "n": 0,
      "t": "القوات البحرية للجيش الايراني:\nقبل ساعات، اصطدمت ناقلة نفط متورطة في مخالفات، كانت قد عطلت أنظمة التعرف والملاحة، وتجاهلت التحذيرات الواردة، ودخلت منطقة محظورة في شرق مضيق هرمز، بمدفع بحري، مما أدى إلى اشتعال النيران وتوقفها.\n﻿",
      "ts": 1795616727
    },
    {
      "n": 0,
      "t": "تأكيداً لما نشرناه…\n\nالجيش الإيراني يُعلن اندلاع حريق في ناقلة نفط مخالفة شرقي مضيق هرمز.",
      "ts": 1795616731
    },
    {
      "n": 0,
      "t": "القوات البحرية للجيش الايرانية:\nقبل ساعات، اصطدمت ناقلة نفط متورطة في مخالفات، كانت قد عطلت أنظمة التعرف والملاحة، وتجاهلت التحذيرات الواردة، ودخلت منطقة محظورة في شرق مضيق هرمز، بمدفع بحري، مما أدى إلى اشتعال النيران وتوقفها.\n﻿",
      "ts": 1795616734
    },
    {
      "n": 0,
      "t": "مواطن من اقليم كردستان يمزق جوازه العراقي على خلفية التوتر بين الاقليم وبغداد",
      "ts": 1795617334
    },
    {
      "n": 0,
      "t": "خام برنت يرتفع مجدداً ليصل إلى 93 دولارًا للبرميل الواحد.",
      "ts": 1795617337
    },
    {
      "n": 0,
      "t": "تيكتوكر كردي يُدعى \"مساري مسعود\" يمزق جواز سفره العراقي فوق قلعة أربيل",
      "ts": 1795617344
    },
    {
      "n": 0,
      "t": "القجقجي مسعود البارزاني للسفير الإيطالي: سنبذل كل الجهود لحل المشاكل، ولكن لا يمكن لأي طرف أن يفرض إرادته على شعب كردستان بعقلية إنكارية.",
      "ts": 1795617634
    },
    {
      "n": 0,
      "t": "حزب البرزاني يوجه البيشمركة والاسايش والشرطة وموظفي عدد من المؤسسات للمشاركة غدا في التظاهرات المحتملة في اربيل ضد الحكومة المركزية",
      "ts": 1795617932
    },
    {
      "n": 0,
      "t": "المحور نيوز بموقعها الخاص بالرصد الحراري تؤكد استهداف سفن مخالفة في مضيق هرمز، واندلاع النيران فيها .",
      "ts": 1795617937
    },
    {
      "n": 0,
      "t": "متحديًا الشاب الزيدي … مسعود البارزاني للسفير الإيطالي: لا يمكن لأي طرف أن يفرض إرادته على شعب كردستان بعقلية إنكارية.",
      "ts": 1795617941
    }
